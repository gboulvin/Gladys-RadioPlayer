{
  "manifest_version": 1,
  "type": "device",
  "name": "RadioPlayer",
  "description": {
    "en": "Play your country's web radios on your Google Cast, Sonos and DLNA speakers.",
    "fr": "Écoutez les radios web de votre pays sur vos enceintes Google Cast, Sonos et DLNA.",
    "de": "Webradios Ihres Landes auf Google-Cast-, Sonos- und DLNA-Lautsprechern hören.",
    "es": "Escuche las radios web de su país en sus altavoces Google Cast, Sonos y DLNA."
  },
  "version": "1.0.0",
  "docker_image": "ghcr.io/gboulvin/gladys-radioplayer:1.0.0",
  "gladys_version": ">=5.3.0",
  "cover_image": "https://raw.githubusercontent.com/gboulvin/Gladys-RadioPlayer/main/cover.png",
  "categories": ["multimedia"],
  "keywords": [
    "radio",
    "webradio",
    "Chromecast",
    "Google Cast",
    "Sonos",
    "DLNA",
    "UPnP",
    "Nest",
    "Radio Browser",
    "streaming"
  ],
  "countries": [
    "FR",
    "BE",
    "LU",
    "CH",
    "DE",
    "AT",
    "NL",
    "GB",
    "IE",
    "ES",
    "PT",
    "IT",
    "CA",
    "US",
    "MX",
    "AR",
    "CL",
    "CO",
    "PE",
    "AU"
  ],
  "transports": ["local"],
  "network_discovery": [
    {
      "type": "mdns",
      "service": "_googlecast._tcp"
    },
    {
      "type": "ssdp",
      "st": "urn:schemas-upnp-org:device:MediaRenderer:1"
    },
    {
      "type": "ssdp",
      "st": "urn:schemas-upnp-org:device:ZonePlayer:1"
    }
  ],
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "Getting started",
        "fr": "Pour commencer",
        "de": "Erste Schritte",
        "es": "Primeros pasos"
      },
      "description": {
        "en": "Pick your country: its radio catalog (from the free Radio Browser directory) feeds the music panel, the widgets and the scenes. Then open the Discovery tab to add your speakers. Internet access is needed for the catalog and the streams.",
        "fr": "Choisissez votre pays : son catalogue de radios (annuaire gratuit Radio Browser) alimente le panneau musique, les widgets et les scènes. Ouvrez ensuite l’onglet Découverte pour ajouter vos enceintes. Un accès Internet est nécessaire pour le catalogue et les flux.",
        "de": "Wählen Sie Ihr Land: Sein Radiokatalog (aus dem freien Verzeichnis Radio Browser) speist das Musik-Panel, die Widgets und die Szenen. Fügen Sie dann im Tab „Erkennung“ Ihre Lautsprecher hinzu. Für Katalog und Streams ist Internetzugang nötig.",
        "es": "Elija su país: su catálogo de radios (del directorio gratuito Radio Browser) alimenta el panel de música, los widgets y las escenas. Después abra la pestaña Descubrimiento para añadir sus altavoces. Se necesita acceso a Internet para el catálogo y los flujos."
      },
      "links": [
        {
          "url": "https://www.radio-browser.info",
          "label": {
            "en": "Radio Browser directory",
            "fr": "Annuaire Radio Browser",
            "de": "Radio-Browser-Verzeichnis",
            "es": "Directorio Radio Browser"
          }
        }
      ]
    },
    {
      "key": "country",
      "type": "select",
      "label": {
        "en": "Catalog country",
        "fr": "Pays du catalogue",
        "de": "Katalogland",
        "es": "País del catálogo"
      },
      "description": {
        "en": "The stations offered are those of this country.",
        "fr": "Les stations proposées sont celles de ce pays.",
        "de": "Angeboten werden die Sender dieses Landes.",
        "es": "Las emisoras ofrecidas son las de este país."
      },
      "required": true,
      "default": "FR",
