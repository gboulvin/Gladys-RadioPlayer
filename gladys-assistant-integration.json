  "scene_actions": [
    {
      "key": "play_station",
      "label": {
        "en": "Play a radio station",
        "fr": "Lancer une radio",
        "de": "Radiosender abspielen",
        "es": "Reproducir una emisora"
      },
      "description": {
        "en": "Searches the station in the country catalog and plays it on a speaker.",
        "fr": "Cherche la station dans le catalogue du pays et la lance sur une enceinte.",
        "de": "Sucht den Sender im Landeskatalog und spielt ihn auf einem Lautsprecher.",
        "es": "Busca la emisora en el catálogo del país y la reproduce en un altavoz."
      },
      "timeout_seconds": 30,
      "fields": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Player",
            "fr": "Lecteur",
            "de": "Player",
            "es": "Reproductor"
          },
          "required": true
        },
        {
          "key": "station",
          "type": "string",
          "label": {
            "en": "Station",
            "fr": "Station",
            "de": "Sender",
            "es": "Emisora"
          },
          "description": {
            "en": "Name of the station (or its Radio Browser identifier), searched in the catalog of the configured country.",
            "fr": "Nom de la station (ou son identifiant Radio Browser), cherché dans le catalogue du pays configuré.",
            "de": "Name des Senders (oder seine Radio-Browser-ID), gesucht im Katalog des eingestellten Landes.",
            "es": "Nombre de la emisora (o su identificador de Radio Browser), buscado en el catálogo del país configurado."
          },
          "placeholder": {
            "en": "e.g. France Inter",
            "fr": "ex. France Inter",
            "de": "z. B. Deutschlandfunk",
            "es": "p. ej. Cadena SER"
          },
          "required": true
        },
        {
          "key": "volume",
          "type": "number",
          "label": {
            "en": "Volume (%)",
            "fr": "Volume (%)",
            "de": "Lautstärke (%)",
            "es": "Volumen (%)"
          },
          "description": {
            "en": "Optional. Empty keeps the configured start volume.",
            "fr": "Facultatif. Vide : volume de démarrage de la configuration.",
            "de": "Optional. Leer: Startlautstärke der Konfiguration.",
            "es": "Opcional. Vacío: volumen inicial de la configuración."
          },
          "min": 0,
          "max": 100
        }
      ],
      "outputs": [
        {
