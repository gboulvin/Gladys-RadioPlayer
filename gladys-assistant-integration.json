    {
      "key": "start_volume",
      "type": "number",
      "label": {
        "en": "Start volume (%)",
        "fr": "Volume au démarrage (%)",
        "de": "Startlautstärke (%)",
        "es": "Volumen inicial (%)"
      },
      "description": {
        "en": "Volume set when a station starts. 0 keeps the volume of the speaker.",
        "fr": "Volume réglé au lancement d'une station. 0 garde le volume de l'enceinte.",
        "de": "Lautstärke beim Start eines Senders. 0 behält die Lautstärke des Lautsprechers.",
        "es": "Volumen al iniciar una emisora. 0 mantiene el volumen del altavoz."
      },
      "placeholder": {
        "en": "e.g. 30",
        "fr": "ex. 30",
        "de": "z. B. 30",
        "es": "p. ej. 30"
      },
      "required": false,
      "default": 0,
      "min": 0,
      "max": 100
    },
    {
      "key": "exclude_hls",
      "type": "boolean",
      "label": {
        "en": "Hide HLS streams",
        "fr": "Masquer les flux HLS",
        "de": "HLS-Streams ausblenden",
        "es": "Ocultar flujos HLS"
      },
      "description": {
        "en": "Many DLNA speakers cannot play HLS (.m3u8) streams: keep it on unless all your speakers are Google Cast.",
        "fr": "Beaucoup d’enceintes DLNA ne lisent pas les flux HLS (.m3u8) : laissez activé sauf si toutes vos enceintes sont Google Cast.",
        "de": "Viele DLNA-Lautsprecher spielen keine HLS-Streams (.m3u8): aktiviert lassen, außer alle Lautsprecher sind Google Cast.",
        "es": "Muchos altavoces DLNA no reproducen flujos HLS (.m3u8): déjelo activado salvo que todos sean Google Cast."
      },
      "required": false,
      "default": true
    },
    {
      "key": "discovery",
      "type": "section",
      "label": {
        "en": "Speakers",
        "fr": "Enceintes",
        "de": "Lautsprecher",
        "es": "Altavoces"
      },
      "description": {
        "en": "Gladys looks for the speakers on your local network. The speaker downloads the stream itself: no audio goes through Gladys.",
        "fr": "Gladys cherche les enceintes sur votre réseau local. L’enceinte télécharge le flux elle-même : aucun son ne passe par Gladys.",
        "de": "Gladys sucht die Lautsprecher in Ihrem lokalen Netzwerk. Der Lautsprecher lädt den Stream selbst: Kein Ton läuft über Gladys.",
        "es": "Gladys busca los altavoces en su red local. El altavoz descarga el flujo por sí mismo: ningún sonido pasa por Gladys."
      }
    },
    {
      "key": "enable_cast",
      "type": "boolean",
      "label": {
        "en": "Google Cast speakers",
        "fr": "Enceintes Google Cast",
        "de": "Google-Cast-Lautsprecher",
        "es": "Altavoces Google Cast"
      },
      "description": {
        "en": "Chromecast, Google Nest, Android TV and speakers with Chromecast built-in.",
        "fr": "Chromecast, Google Nest, Android TV et enceintes avec Chromecast intégré.",
        "de": "Chromecast, Google Nest, Android TV und Lautsprecher mit integriertem Chromecast.",
        "es": "Chromecast, Google Nest, Android TV y altavoces con Chromecast integrado."
      },
      "required": false,
      "default": true
    },
    {
      "key": "enable_upnp",
      "type": "boolean",
      "label": {
        "en": "Sonos and UPnP/DLNA speakers",
        "fr": "Enceintes Sonos et UPnP/DLNA",
        "de": "Sonos- und UPnP/DLNA-Lautsprecher",
        "es": "Altavoces Sonos y UPnP/DLNA"
      },
      "description": {
        "en": "Sonos, network receivers, smart TVs, Freebox Player, Kodi and other DLNA renderers.",
        "fr": "Sonos, amplis réseau, téléviseurs, Freebox Player, Kodi et autres lecteurs DLNA.",
        "de": "Sonos, Netzwerk-Receiver, Smart-TVs, Kodi und andere DLNA-Renderer.",
        "es": "Sonos, receptores de red, televisores, Kodi y otros reproductores DLNA."
      },
      "required": false,
      "default": true
    },
    {
      "key": "manual_players",
      "type": "string",
      "label": {
        "en": "Speakers added by hand",
        "fr": "Enceintes ajoutées à la main",
        "de": "Manuell hinzugefügte Lautsprecher",
        "es": "Altavoces añadidos a mano"
      },
      "description": {
        "en": "For a speaker the scan does not find: the IP address of a Google Cast device, or the URL of a UPnP description. Separate several entries with commas.",
        "fr": "Pour une enceinte que la recherche ne trouve pas : l'adresse IP d'un appareil Google Cast, ou l'URL d'une description UPnP. Séparez plusieurs entrées par des virgules.",
        "de": "Für einen Lautsprecher, den die Suche nicht findet: die IP-Adresse eines Google-Cast-Geräts oder die URL einer UPnP-Beschreibung. Mehrere Einträge mit Kommas trennen.",
        "es": "Para un altavoz que la búsqueda no encuentra: la dirección IP de un dispositivo Google Cast o la URL de una descripción UPnP. Separe varias entradas con comas."
      },
      "placeholder": {
        "en": "e.g. 192.168.1.20, http://192.168.1.30:1400/xml/device_description.xml",
        "fr": "ex. 192.168.1.20, http://192.168.1.30:1400/xml/device_description.xml",
        "de": "z. B. 192.168.1.20, http://192.168.1.30:1400/xml/device_description.xml",
        "es": "p. ej. 192.168.1.20, http://192.168.1.30:1400/xml/device_description.xml"
      },
      "required": false,
      "default": ""
    }
  ],
  "actions": [
    {
      "key": "test_catalog",
      "label": {
        "en": "Test the radio catalog",
        "fr": "Tester le catalogue des radios",
        "de": "Radiokatalog testen",
        "es": "Probar el catálogo de radios"
      },
      "timeout_seconds": 30
    },
    {
      "key": "test_player",
      "label": {
        "en": "Test a speaker",
        "fr": "Tester une enceinte",
        "de": "Lautsprecher testen",
        "es": "Probar un altavoz"
      },
      "timeout_seconds": 20,
      "fields": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Player",
            "fr": "Lecteur",
            "de": "Player",
            "es": "Reproductor"
          },
          "required": true
        }
      ]
    },
    {
      "key": "add_favorite",
      "label": {
        "en": "Add a favorite",
        "fr": "Ajouter un favori",
        "de": "Favorit hinzufügen",
        "es": "Añadir un favorito"
      },
      "timeout_seconds": 20,
      "fields": [
        {
          "key": "station",
          "type": "string",
          "label": {
            "en": "Station",
            "fr": "Station",
            "de": "Sender",
            "es": "Emisora"
          },
          "description": {
            "en": "Name of the station (or its Radio Browser identifier), searched in the catalog of the configured country.",
            "fr": "Nom de la station (ou son identifiant Radio Browser), cherché dans le catalogue du pays configuré.",
            "de": "Name des Senders (oder seine Radio-Browser-ID), gesucht im Katalog des eingestellten Landes.",
            "es": "Nombre de la emisora (o su identificador de Radio Browser), buscado en el catálogo del país configurado."
          },
          "placeholder": {
            "en": "e.g. France Inter",
            "fr": "ex. France Inter",
            "de": "z. B. Deutschlandfunk",
            "es": "p. ej. Cadena SER"
          },
          "required": true
        }
      ]
    },
    {
      "key": "remove_favorite",
      "label": {
        "en": "Remove a favorite",
        "fr": "Retirer un favori",
        "de": "Favorit entfernen",
        "es": "Quitar un favorito"
      },
      "fields": [
        {
          "key": "station",
          "type": "string",
          "label": {
            "en": "Station",
            "fr": "Station",
            "de": "Sender",
            "es": "Emisora"
          },
          "description": {
            "en": "Name of the favorite to remove.",
            "fr": "Nom du favori à retirer.",
            "de": "Name des zu entfernenden Favoriten.",
            "es": "Nombre del favorito a quitar."
          },
          "placeholder": {
            "en": "e.g. France Inter",
            "fr": "ex. France Inter",
            "de": "z. B. Deutschlandfunk",
            "es": "p. ej. Cadena SER"
          },
          "required": true
        }
      ]
    },
    {
      "key": "list_favorites",
      "label": {
        "en": "List the favorites",
        "fr": "Lister les favoris",
        "de": "Favoriten anzeigen",
        "es": "Ver los favoritos"
      }
    }
  ],
